{
  "name": "openchamber-token-usage",
  "version": "0.1.0",
  "private": true,
  "description": "OpenChamber 扩展：本机 Token 用量与费用统计（可自定义单价、峰谷与长上下文）",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.6.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "token-usage",
        "name": "Token 用量",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "attach": false
    }
  }
}
